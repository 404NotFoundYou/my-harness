          "line": 64,
          "text": "#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]"
        },
        {
          "line": 65,
          "text": "async fn exec_command_tool_executes_command_and_streams_output() -> anyhow::Result<()> {"
        },
        {
          "line": 66,
          "text": "    skip_if_no_network!(Ok(()));"
        },
        {
          "line": 67,
          "text": ""
        },
        {
          "line": 68,
          "text": "    let server = start_mock_server().await;"
        },
        {
          "line": 69,
          "text": ""
        },
        {
          "line": 70,
          "text": "    let mut builder = test_codex().with_model(\"test-gpt-5-codex\");"
        },
        {
          "line": 71,
          "text": "    let TestCodex {"
        },
        {
          "line": 72,
          "text": "        codex,"
        },
        {
          "line": 73,
          "text": "        cwd,"
        },
        {
          "line": 74,
          "text": "        session_configured,"
        },
        {
          "line": 75,
          "text": "        .."
        },
        {
          "line": 76,
          "text": "    } = builder.build(&server).await?;"
        },
        {
          "line": 77,
          "text": ""
        },
        {
          "line": 78,
          "text": "    let call_id = \"exec-command-tool-call\";"
        },
        {
          "line": 79,
          "text": "    let command_args = json!({"
        },
        {
          "line": 80,
          "text": "        \"cmd\": \"echo tool harness\","
        },
        {
          "line": 81,
          "text": "        \"login\": false,"
        },
        {
          "line": 82,
          "text": "    })"
        },
        {
          "line": 83,
          "text": "    .to_string();"
        },
        {
          "line": 84,
          "text": "    let first_response = sse(vec!["
        },
        {
          "line": 85,
          "text": "        ev_response_created(\"resp-1\"),"
        },
        {
          "line": 86,
          "text": "        ev_function_call(call_id, \"exec_command\", &command_args),"
        },
        {
          "line": 87,
          "text": "        ev_completed(\"resp-1\"),"
        },
        {
          "line": 88,
          "text": "    ]);"
        },
        {
          "line": 89,
          "text": "    responses::mount_sse_once(&server, first_response).await;"
        },
        {
          "line": 90,
          "text": ""
        },
        {
          "line": 91,
          "text": "    let second_response = sse(vec!["
        },
        {
          "line": 92,
          "text": "        ev_assistant_message(\"msg-1\", \"all done\"),"
        },
        {
          "line": 93,
          "text": "        ev_completed(\"resp-2\"),"
        },
        {
          "line": 94,
          "text": "    ]);"
        },
        {
          "line": 95,
          "text": "    let second_mock = responses::mount_sse_once(&server, second_response).await;"
        }
      ]
