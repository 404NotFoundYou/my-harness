{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-harness/schemas/begin-spec.schema.json",
  "title": "Compact task input",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "title", "references", "acceptance", "authorizationSource", "risk", "approach", "databaseEvidence", "writeScopes", "verification", "docsImpact"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "type": {"enum": ["ITERATION", "BUGFIX"]},
    "title": {"type": "string", "minLength": 1},
    "references": {"$ref": "#/$defs/strings"},
    "acceptance": {"$ref": "#/$defs/strings"},
    "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "version": {"type": ["string", "null"]},
    "authorizationMode": {"const": "autonomous"},
    "authorizationSource": {"type": "string", "minLength": 1},
    "flags": {"type": "array", "uniqueItems": true, "items": {"const": "frontend"}},
    "bug": {"$ref": "work-item.schema.json#/properties/bug"},
    "risk": {"enum": ["low", "medium"]},
    "approach": {"type": "string", "minLength": 1},
    "databaseEvidence": {"type": "string", "minLength": 1},
    "writeScopes": {"$ref": "#/$defs/strings"},
    "verification": {
      "type": "array", "minItems": 1,
      "items": {"oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "required": ["command", "args"], "properties": {"command": {"type": "string", "minLength": 1}, "args": {"type": "array", "items": {"type": "string"}}, "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^A[1-9][0-9]*$"}}}, "additionalProperties": false}
      ]}
    },
    "docsImpact": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
  "additionalProperties": false
}
