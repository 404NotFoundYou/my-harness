        {
          "line": 717,
          "text": "pub fn sse(events: Vec<Value>) -> String {"
        },
        {
          "line": 718,
          "text": "    use std::fmt::Write as _;"
        },
        {
          "line": 719,
          "text": "    let mut out = String::new();"
        },
        {
          "line": 720,
          "text": "    for ev in events {"
        },
        {
          "line": 721,
          "text": "        let kind = ev.get(\"type\").and_then(|v| v.as_str()).unwrap();"
        },
        {
          "line": 722,
          "text": "        writeln!(&mut out, \"event: {kind}\").unwrap();"
        },
        {
          "line": 723,
          "text": "        if !ev.as_object().map(|o| o.len() == 1).unwrap_or(false) {"
        },
        {
          "line": 724,
          "text": "            write!(&mut out, \"data: {ev}\\n\\n\").unwrap();"
        },
        {
          "line": 725,
          "text": "        } else {"
        },
        {
          "line": 726,
          "text": "            out.push('\\n');"
        },
        {
          "line": 727,
          "text": "        }"
        },
        {
          "line": 728,
          "text": "    }"
        },
        {
          "line": 729,
          "text": "    out"
        },
        {
          "line": 730,
          "text": "}"
        },
        {
          "line": 731,
          "text": ""
        },
        {
          "line": 732,
          "text": "pub fn sse_completed(id: &str) -> String {"
        },
        {
          "line": 733,
          "text": "    sse(vec![ev_response_created(id), ev_completed(id)])"
        },
        {
          "line": 734,
          "text": "}"
        },
        {
          "line": 735,
          "text": ""
        },
        {
          "line": 736,
          "text": "/// Convenience: SSE event for a completed response with a specific id."
        },
        {
          "line": 737,
          "text": "pub fn ev_completed(id: &str) -> Value {"
        },
        {
          "line": 738,
          "text": "    serde_json::json!({"
        },
        {
          "line": 739,
          "text": "        \"type\": \"response.completed\","
        },
        {
          "line": 740,
          "text": "        \"response\": {"
        },
        {
          "line": 741,
          "text": "            \"id\": id,"
        },
        {
          "line": 742,
          "text": "            \"usage\": {\"input_tokens\":0,\"input_tokens_details\":null,\"output_tokens\":0,\"output_tokens_details\":null,\"total_tokens\":0}"
        },
        {
          "line": 743,
          "text": "        }"
        },
        {
          "line": 744,
          "text": "    })"
        },
        {
          "line": 745,
          "text": "}"
        },
        {
          "line": 746,
          "text": ""
        },
        {
          "line": 747,
          "text": "/// Convenience: SSE event for a created response with a specific id."
        },
        {
          "line": 748,
          "text": "pub fn ev_response_created(id: &str) -> Value {"
        },
        {
          "line": 749,
          "text": "    serde_json::json!({"
        },
        {
          "line": 750,
          "text": "        \"type\": \"response.created\","
        },
        {
          "line": 751,
          "text": "        \"response\": {"
        },
        {
          "line": 752,
          "text": "            \"id\": id,"
        },
        {
          "line": 753,
          "text": "        }"
        },
        {
          "line": 754,
          "text": "    })"
        },
        {
          "line": 755,
          "text": "}"
        },
        {
          "line": 785,
          "text": "pub fn ev_assistant_message(id: &str, text: &str) -> Value {"
        },
        {
          "line": 786,
          "text": "    serde_json::json!({"
        },
        {
          "line": 787,
          "text": "        \"type\": \"response.output_item.done\","
        },
        {
          "line": 788,
          "text": "        \"item\": {"
        },
        {
          "line": 789,
          "text": "            \"type\": \"message\","
        },
        {
          "line": 790,
          "text": "            \"role\": \"assistant\","
        },
        {
          "line": 791,
          "text": "            \"id\": id,"
        },
        {
          "line": 792,
          "text": "            \"content\": [{\"type\": \"output_text\", \"text\": text}]"
        },
        {
          "line": 793,
          "text": "        }"
        },
        {
          "line": 794,
          "text": "    })"
        },
        {
          "line": 933,
          "text": "pub fn ev_function_call(call_id: &str, name: &str, arguments: &str) -> Value {"
        },
        {
          "line": 934,
          "text": "    serde_json::json!({"
        },
        {
          "line": 935,
          "text": "        \"type\": \"response.output_item.done\","
        },
        {
          "line": 936,
          "text": "        \"item\": {"
        },
        {
          "line": 937,
          "text": "            \"type\": \"function_call\","
        },
        {
          "line": 938,
          "text": "            \"call_id\": call_id,"
        },
        {
          "line": 939,
          "text": "            \"name\": name,"
        },
        {
          "line": 940,
          "text": "            \"arguments\": arguments"
        },
        {
          "line": 941,
          "text": "        }"
        },
        {
          "line": 942,
          "text": "    })"
        },
        {
          "line": 943,
          "text": "}"
        }
      ]
