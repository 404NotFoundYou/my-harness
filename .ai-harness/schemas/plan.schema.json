{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-harness/schemas/plan.schema.json",
  "title": "AI Harness execution plan",
  "type": "object",
  "required": ["schemaVersion", "workItemId", "mode", "rationale", "tasks", "reviewBatches", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItemId": {"type": "string"},
    "mode": {"enum": ["single", "multi"]},
    "rationale": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "module",
          "status",
          "blockedBy",
          "blocks",
          "writeScopes",
          "verification",
          "docsImpact",
          "reviewBatch",
          "risk",
          "owner",
          "verificationStatus",
          "reviewStatus",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
          "title": {"type": "string", "minLength": 1},
          "module": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "READY", "IN_PROGRESS", "IMPLEMENTED", "IN_REVIEW", "REWORK", "COMPLETED", "BLOCKED", "DEFERRED"]},
          "blockedBy": {"type": "array", "items": {"type": "string"}},
          "blocks": {"type": "array", "items": {"type": "string"}},
          "writeScopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "docsImpact": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reviewBatch": {"type": "string", "minLength": 1},
          "risk": {"enum": ["low", "medium", "high"]},
          "owner": {"type": "string", "minLength": 1},
          "verificationStatus": {"enum": ["pending", "pass", "fail", "blocked", "not-applicable"]},
          "reviewStatus": {"enum": ["pending", "pass", "fail", "blocked", "not-applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "deferralApproval": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "reviewBatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "risk", "taskIds", "independentRequired"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high"]},
          "taskIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "independentRequired": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
