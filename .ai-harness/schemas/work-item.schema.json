{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-harness/schemas/work-item.schema.json",
  "title": "AI Harness work item",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "type",
    "title",
    "status",
    "flags",
    "policyFiles",
    "authorization",
    "input",
    "architecture",
    "bug",
    "baseline",
    "solution",
    "database",
    "plan",
    "verification",
    "review",
    "acceptance",
    "analysis",
    "documentation",
    "history",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "integrityVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "delivery": {
      "type": ["object", "null"],
      "required": ["source", "baseline", "baselineAt", "ownedChanges", "planDigest", "at", "head"],
      "properties": {
        "source": {"$ref": "#/$defs/snapshotRef"},
        "baseline": {"$ref": "#/$defs/snapshotRef"},
        "baselineAt": {"type": "string", "format": "date-time"},
        "ownedChanges": {
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "before", "after"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "before": {"type": ["string", "null"], "pattern": "^\\d{6}:[0-9a-f]{40,64}$"},
              "after": {"type": ["string", "null"], "pattern": "^\\d{6}:[0-9a-f]{40,64}$"}
            },
            "additionalProperties": false
          }
        },
        "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "at": {"type": "string", "format": "date-time"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      },
      "additionalProperties": false
    },
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "type": {"enum": ["NEW_PROJECT", "ITERATION", "BUGFIX", "ANALYSIS"]},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "INTAKE",
        "BASELINING",
        "SOLUTION_DESIGN",
        "DATABASE_DESIGN",
        "PLANNED",
        "IMPLEMENTING",
        "VERIFYING",
        "CODE_REVIEW",
        "READY_FOR_ACCEPTANCE",
        "DONE",
        "ANALYZING",
        "ANSWERED",
        "BLOCKED"
      ]
    },
    "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["database", "frontend", "mobile", "api", "multi-agent", "codegen"]}},
    "policyFiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authorization": {
      "type": "object",
      "required": ["mode", "source"],
      "properties": {
        "mode": {"enum": ["autonomous", "approval-required"]},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["references", "acceptance", "nonGoals"],
      "properties": {
        "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["source", "approvalRef"],
      "properties": {
        "source": {"enum": ["HUMAN_PROVIDED", "AI_RECOMMENDED", null]},
        "approvalRef": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "bug": {
      "type": ["object", "null"],
      "properties": {
        "actual": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 1}
      },
      "required": ["actual", "expected", "reproduction"],
      "additionalProperties": false
    },
    "baseline": {"$ref": "#/$defs/gate"},
    "solution": {"$ref": "#/$defs/gate"},
    "database": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {
          "type": "object",
          "required": ["impact"],
          "properties": {"impact": {"enum": ["unknown", "none", "required"]}}
        }
      ]
    },
    "plan": {
      "type": "object",
      "required": ["path", "approved", "approvalRef"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "approved": {"type": "boolean"},
        "approvalRef": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "type": "object",
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stage", "status", "evidence"],
                "properties": {
                  "stage": {"enum": ["static", "sandbox", "contract", "eval", "reproduction", "regression", "browser"]},
                  "status": {"enum": ["pending", "pass", "fail", "blocked", "not-applicable"]},
                  "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "source": {"$ref": "#/$defs/snapshotRef"},
                  "revision": {"type": "integer", "minimum": 1},
                  "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "command": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "review": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "type": "object",
          "required": ["independent"],
          "properties": {"independent": {"type": "boolean"}}
        }
      ]
    },
    "acceptance": {"$ref": "#/$defs/result"},
    "analysis": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "type": "object",
          "required": ["conclusions", "unknowns"],
          "properties": {
            "conclusions": {"type": "array"},
            "unknowns": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "documentation": {"$ref": "#/$defs/result"},
    "blocked": {"type": ["object", "null"]},
    "history": {"type": "array", "minItems": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "snapshotRef": {
      "type": "object",
      "required": ["digest", "document"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "document": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["status", "document", "evidence", "completedAt"],
      "properties": {
        "status": {"enum": ["pending", "complete", "not-applicable"]},
        "document": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "repository": {"type": ["object", "null"]}
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "source": {"$ref": "#/$defs/snapshotRef"},
        "status": {"enum": ["pending", "pass", "fail", "blocked", "not-applicable"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "NEW_PROJECT"}}},
      "then": {
        "properties": {
          "architecture": {
            "properties": {
              "source": {"enum": ["HUMAN_PROVIDED", "AI_RECOMMENDED"]},
              "approvalRef": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "BUGFIX"}}},
      "then": {"properties": {"bug": {"type": "object"}}}
    }
  ],
  "additionalProperties": false
}
